{
  "name": "suika-yatai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "vite build && zmp deploy --outputDir www"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zmp-vite-plugin": "^1.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/matter-js": "^0.19.8",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "5"
  }
}
